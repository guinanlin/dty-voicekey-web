# Backend API base URL（服务端 Next.js 使用，Docker 内为 http://backend:8000）
API_BASE_URL=http://localhost:8600

# 浏览器可直连的 Relay WebSocket 地址（Dev Container 需设为宿主机可达地址）
# Dev Container 示例：ws://localhost:8601/relay/ws
# 宿主机直跑时留空，自动从 API_BASE_URL 推导
NEXT_PUBLIC_RELAY_WS_URL=

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json