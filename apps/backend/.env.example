# Local database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5600/mydatabase

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5610/testdatabase

# Secret keys
ACCESS_SECRET_KEY=your_access_secret_key
RESET_PASSWORD_SECRET_KEY=your_reset_password_secret_key
VERIFICATION_SECRET_KEY=your_verification_secret_key

# OpenAPI genrated file output path
OPENAPI_OUTPUT_FILE=../frontend/openapi.json

# Localhost Email configuration
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@test.com
MAIL_PORT=8630
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# Frontend (NextJS)
FRONTEND_URL=http://localhost:3600

# CORS (Allow all origins for development; adjust this to restrict origins in production deployments)
CORS_ORIGINS=["*"]

# Redis (verification codes, rate limiting)
REDIS_URL=redis://localhost:6379/0

# OSS Gateway (backend calls gateway API; do not import oss2/boto3 in business code)
OSS_GATEWAY_BASE_URL=http://localhost:8610
OSS_GATEWAY_SERVICE_TOKEN=dev-service-token-change-in-production

# SMS Forward Webhook (Android device inbound)
SMS_FORWARD_REQUIRE_API_KEY=true
SMS_FORWARD_DEFAULT_USER_EMAIL=admin@dty.com
SMS_FORWARD_DEFAULT_API_KEY=dev-sms-forward-key-change-in-production
# OPENAPI_URL=""

# Dev seed admin (optional; defaults: admin@dty.com / admin123)
# SEED_ADMIN_EMAIL=admin@dty.com
# SEED_ADMIN_PASSWORD=admin123