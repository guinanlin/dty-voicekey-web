# Database (shared PostgreSQL instance; oss_* tables owned by this service)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5600/mydatabase
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5610/testdatabase

# Service auth (comma-separated tokens for backend -> gateway calls)
SERVICE_TOKENS=dev-service-token-change-in-production

# Default storage provider: local | s3 | oss
DEFAULT_PROVIDER=local

# Local provider (dev only; small files via gateway proxy)
LOCAL_STORAGE_PATH=./storage
LOCAL_BUCKET=local-dev
LOCAL_PUBLIC_BASE_URL=http://localhost:8610

# S3-compatible (MinIO / AWS / R2 / OBS-S3 / COS-S3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=dev-bucket

# Aliyun OSS (native SDK)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=dev-bucket

# Presign TTL (seconds)
PRESIGN_UPLOAD_TTL=3600
PRESIGN_DOWNLOAD_TTL=3600

# CORS
CORS_ORIGINS=["*"]

# OpenAPI
OPENAPI_URL=/openapi.json
