# 传声筒 - FastAPI 后端（生产）
#
# 阿里云 ACR 构建示例：
#   构建上下文目录: /
#   Dockerfile 文件名: docker/Dockerfile.backend
#   版本规则: tags:release-v$version  ->  镜像版本 1.0.0
#
# 本地验证：
#   docker build -f docker/Dockerfile.backend -t dty-backend:local .
#
# Dokploy 部署时需注入环境变量，例如：
#   DATABASE_URL, REDIS_URL, ACCESS_SECRET_KEY, CORS_ORIGINS 等
#   详见 apps/backend/.env.example

FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# uv workspace：锁文件在仓库根目录（构建上下文为 /）
COPY pyproject.toml uv.lock ./
COPY apps/backend/pyproject.toml apps/backend/
COPY apps/backend_oss_gateway/pyproject.toml apps/backend_oss_gateway/
COPY packages/py/common/pyproject.toml packages/py/common/

WORKDIR /app/apps/backend

# 安装运行时 + alembic（用于启动前迁移）
RUN uv sync --frozen --no-dev \
  && uv pip install alembic

COPY apps/backend/ .

ENV PATH="/app/apps/backend/.venv/bin:$PATH" \
  PYTHONUNBUFFERED=1 \
  PORT=8000

RUN chmod +x docker-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["./docker-entrypoint.sh"]
