# 传声筒 - Next.js 前端（生产）
#
# 阿里云 ACR 构建示例：
#   构建上下文目录: /
#   Dockerfile 文件名: docker/Dockerfile.frontend
#   建议镜像命名: dty-voicekey-web-frontend:1.0.0
#
# 本地验证：
#   docker build -f docker/Dockerfile.frontend -t dty-frontend:local .
#
# Dokploy 运行时环境变量：
#   API_BASE_URL=https://api.example.com
#   PORT=3000

FROM oven/bun:1.3-debian AS builder

WORKDIR /app

# Bun workspace（@dty/tsconfig 在 packages/ts/tsconfig）
COPY package.json bun.lock ./
COPY packages/ts/tsconfig ./packages/ts/tsconfig
COPY apps/frontend/package.json ./apps/frontend/

RUN bun install --frozen-lockfile

COPY apps/frontend ./apps/frontend

WORKDIR /app/apps/frontend

ENV NEXT_TELEMETRY_DISABLED=1
RUN bun --bun run build

FROM oven/bun:1.3-debian AS runner

WORKDIR /app

ENV NODE_ENV=production \
  NEXT_TELEMETRY_DISABLED=1 \
  PORT=3000 \
  HOSTNAME=0.0.0.0

RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/frontend/public ./apps/frontend/public
COPY --from=builder /app/apps/frontend/.next/standalone ./
COPY --from=builder /app/apps/frontend/.next/static ./apps/frontend/.next/static

USER nextjs

EXPOSE 3000

CMD ["bun", "apps/frontend/server.js"]
