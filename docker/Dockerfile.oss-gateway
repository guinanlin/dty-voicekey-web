# 传声筒 - OSS Gateway（生产）
#
# 阿里云 ACR 构建示例：
#   构建上下文目录: /
#   Dockerfile 文件名: docker/Dockerfile.oss-gateway
#   建议镜像命名: dty-voicekey-web-oss:1.0.0
#
# 本地验证：
#   docker build -f docker/Dockerfile.oss-gateway -t dty-oss:local .
#
# Dokploy 运行时环境变量：
#   DATABASE_URL, SERVICE_TOKENS, LOCAL_STORAGE_PATH 等
#   详见 apps/backend_oss_gateway/.env.example

FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
COPY apps/backend/pyproject.toml apps/backend/
COPY apps/backend_oss_gateway/pyproject.toml apps/backend_oss_gateway/
COPY packages/py/common/pyproject.toml packages/py/common/

WORKDIR /app/apps/backend_oss_gateway

RUN uv sync --frozen --no-dev \
  && uv pip install alembic

COPY apps/backend_oss_gateway/ .

ENV PATH="/app/apps/backend_oss_gateway/.venv/bin:$PATH" \
  PYTHONUNBUFFERED=1 \
  PORT=8000

RUN chmod +x docker-entrypoint.sh \
  && mkdir -p storage

EXPOSE 8000

ENTRYPOINT ["./docker-entrypoint.sh"]
